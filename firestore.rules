rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function enabledUser() {
      return signedIn()
        && exists(profilePath(request.auth.uid))
        && get(profilePath(request.auth.uid)).data.disabled == false;
    }

    function currentProfile() {
      return get(profilePath(request.auth.uid)).data;
    }

    function isAdmin() {
      return enabledUser() && currentProfile().role in ['Developer', 'IT Admin'];
    }

    function isItAdmin() {
      return enabledUser() && currentProfile().role in ['Developer', 'IT Admin'];
    }

    function canSubmitAccountApproval() {
      return enabledUser()
        && currentProfile().role in ['IT Manager', 'IT Support']
        && currentProfile().permissions is list
        && 'addAccount' in currentProfile().permissions;
    }

    function canAccessOffice(office) {
      return enabledUser()
        && office in ['Cebu', 'Thermal']
        && (isAdmin()
          || (currentProfile().role == 'IT Manager'
            && office in ['Cebu', 'Thermal'])
          || (currentProfile().role == 'IT Support'
            && office == 'Cebu')
          || (currentProfile().role in ['Management', 'Accounting', 'HR']
            && office in ['Cebu', 'Thermal'])
          || (currentProfile().permissions is list
            && 'inventory' in currentProfile().permissions
            && (currentProfile().office == 'Both'
              || (currentProfile().inventoryAccess is list
                && office in currentProfile().inventoryAccess))));
    }

    function canManageOffice(office) {
      return canAccessOffice(office)
        && (currentProfile().role in ['Developer', 'IT Admin', 'IT Manager', 'IT Support']
          || (office == 'Thermal'
            && currentProfile().role in ['Management', 'Accounting', 'HR']));
    }

    function canDeleteOffice(office) {
      return canManageOffice(office)
        && currentProfile().role in ['Developer', 'IT Admin', 'IT Manager', 'IT Support'];
    }

    function canManageUsers() {
      return enabledUser()
        && currentProfile().role in ['Developer', 'IT Admin', 'IT Manager', 'IT Support'];
    }

    function canManageTargetRole(role) {
      return currentProfile().role == 'Developer'
        || (currentProfile().role == 'IT Admin' && role != 'Developer')
        || (currentProfile().role == 'IT Manager'
        && role in ['IT Support', 'Management', 'Accounting', 'HR', 'Station'])
        || (currentProfile().role == 'IT Support'
        && role in ['Management', 'Accounting', 'HR', 'Station']);
    }

    function validRoleProfile(profile) {
      return !(profile.role in ['IT Admin', 'IT Manager', 'IT Support', 'Management', 'Accounting', 'HR', 'Station'])
        || (profile.role == 'IT Admin'
          && profile.office == 'Both'
          && profile.inventoryAccess is list
          && profile.inventoryAccess.size() == 3
          && profile.inventoryAccess.hasAll(['Cebu', 'Thermal', 'Requests'])
          && profile.permissions is list
          && profile.permissions.size() == 9
          && profile.permissions.hasAll(['dashboard', 'analytics', 'reports', 'inventory', 'settings', 'addAccount', 'users', 'assignedTasks', 'administrator']))
        || (profile.role == 'IT Manager'
          && profile.office == 'Both'
          && profile.inventoryAccess is list
          && profile.inventoryAccess.size() == 2
          && 'Cebu' in profile.inventoryAccess
          && 'Thermal' in profile.inventoryAccess
          && profile.permissions is list
          && profile.permissions.size() == 3
          && profile.permissions.hasAll(['inventory', 'addAccount', 'users']))
        || (profile.role == 'IT Support'
          && profile.office == 'Cebu'
          && profile.inventoryAccess is list
          && profile.inventoryAccess.size() == 1
          && 'Cebu' in profile.inventoryAccess
          && profile.permissions is list
          && profile.permissions.size() == 3
          && profile.permissions.hasAll(['inventory', 'addAccount', 'users']))
        || (profile.role in ['Management', 'Accounting', 'HR']
          && profile.office == 'Both'
          && profile.inventoryAccess is list
          && profile.inventoryAccess.size() == 2
          && 'Cebu' in profile.inventoryAccess
          && 'Thermal' in profile.inventoryAccess
          && profile.permissions is list
          && profile.permissions.size() == 1
          && 'inventory' in profile.permissions)
        || (profile.role == 'Station'
          && profile.office in ['Guadalupe Station', 'Punta Princessa Station', 'Babag Station']
          && profile.inventoryAccess is list
          && profile.inventoryAccess.size() == 1
          && 'Requests' in profile.inventoryAccess
          && profile.permissions is list
          && profile.permissions.size() == 0);
    }

    function canSubmitRequests() {
      return enabledUser()
        && (isAdmin()
          || (currentProfile().inventoryAccess is list
            && 'Requests' in currentProfile().inventoryAccess));
    }

    function canManageRequests() {
      return enabledUser()
        && (isAdmin()
          || currentProfile().role == 'IT Manager'
          || currentProfile().role == 'Management'
          || currentProfile().role == 'Accounting'
          || (currentProfile().permissions is list
            && 'inventory' in currentProfile().permissions
            && currentProfile().inventoryAccess is list
            && 'Thermal' in currentProfile().inventoryAccess
            && !(currentProfile().role in ['Management', 'Accounting', 'HR', 'IT Support'])));
    }

    function canChangeRequestStatus() {
      return enabledUser()
        && currentProfile().role in ['IT Admin', 'IT Manager', 'Management', 'Accounting'];
    }

    function validCollectorProfile(profile) {
      return profile.role != 'Collector'
        || (profile.office == 'Collector'
          && profile.permissions is list
          && profile.permissions.size() == 0
          && profile.inventoryAccess is list
          && profile.inventoryAccess.size() == 1
          && 'Requests' in profile.inventoryAccess);
    }

    function isThermalStation(station) {
      return station in ['Guadalupe Station', 'Punta Princessa Station', 'Babag Station'];
    }

    function isThermalInventoryGroup(group) {
      return isThermalStation(group) || group == 'Collector';
    }

    function canReadStationThermal(station) {
      return enabledUser()
        && currentProfile().inventoryAccess is list
        && 'Requests' in currentProfile().inventoryAccess
        && ((currentProfile().role == 'Station'
            && isThermalStation(station)
            && currentProfile().office == station)
          || (currentProfile().role == 'Collector'
            && station == 'Collector'
            && currentProfile().office == 'Collector'));
    }

    match /users/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid)
        || canManageUsers();
      allow list: if canManageUsers();
      allow create: if canManageUsers()
        && canManageTargetRole(request.resource.data.role)
        && validCollectorProfile(request.resource.data)
        && validRoleProfile(request.resource.data)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'name', 'email', 'role', 'permissions',
          'office', 'inventoryAccess', 'disabled', 'pendingApproval', 'theme'
        ])
        && ((isAdmin() && !('pendingApproval' in request.resource.data))
          || (canSubmitAccountApproval()
            && request.resource.data.disabled == true
            && request.resource.data.pendingApproval == true));
      allow update: if (isAdmin()
          && validCollectorProfile(request.resource.data)
          && validRoleProfile(request.resource.data)
          && request.resource.data.uid == uid
          && request.resource.data.keys().hasOnly([
            'uid', 'username', 'name', 'email', 'role', 'permissions',
            'office', 'inventoryAccess', 'disabled', 'pendingApproval', 'theme'
          ]))
        || (canManageUsers()
          && !('pendingApproval' in resource.data)
          && !('pendingApproval' in request.resource.data)
          && canManageTargetRole(resource.data.role)
          && canManageTargetRole(request.resource.data.role)
          && validCollectorProfile(request.resource.data)
          && validRoleProfile(request.resource.data)
          && request.resource.data.uid == uid
          && request.resource.data.keys().hasOnly([
            'uid', 'username', 'name', 'email', 'role', 'permissions',
            'office', 'inventoryAccess', 'disabled', 'pendingApproval', 'theme'
          ]))
        || enabledUser()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['theme'])
          && request.resource.data.theme in ['light', 'dark'];
      allow delete: if isAdmin();
    }

    match /accountApprovalRequests/{requestId} {
      allow get, list: if isItAdmin();
      allow create: if canSubmitAccountApproval()
        && requestId == request.resource.data.uid
        && request.resource.data.status == 'Pending'
        && request.resource.data.requestedBy == currentProfile().username
        && request.resource.data.uid is string
        && request.resource.data.username is string
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.role is string
        && request.resource.data.office is string
        && request.resource.data.inventoryAccess is list
        && request.resource.data.permissions is list
        && request.resource.data.requestedAt is string
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'name', 'email', 'role', 'office',
          'inventoryAccess', 'permissions', 'requestedBy', 'requestedAt', 'status'
        ])
        && existsAfter(profilePath(request.resource.data.uid))
        && getAfter(profilePath(request.resource.data.uid)).data.pendingApproval == true
        && getAfter(profilePath(request.resource.data.uid)).data.disabled == true
        && getAfter(profilePath(request.resource.data.uid)).data.username == request.resource.data.username
        && getAfter(profilePath(request.resource.data.uid)).data.email == request.resource.data.email
        && getAfter(profilePath(request.resource.data.uid)).data.role == request.resource.data.role;
      allow update: if isItAdmin()
        && resource.data.status == 'Pending'
        && request.resource.data.status == 'Approved'
        && request.resource.data.approvedBy == currentProfile().username
        && request.resource.data.approvedAt is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'approvedBy', 'approvedAt'
        ])
        && getAfter(profilePath(resource.data.uid)).data.disabled == false
        && getAfter(profilePath(resource.data.uid)).data.pendingApproval == false;
      allow delete: if false;
    }

    match /inventory/{office} {
      allow read: if canAccessOffice(office);
      allow create, update: if canManageOffice(office);
      allow delete: if canDeleteOffice(office);

      match /chunks/{chunkId} {
        allow read: if canAccessOffice(office);
        allow create, update: if canManageOffice(office);
        allow delete: if canDeleteOffice(office);
      }

      match /history/{entryId} {
        allow read: if canAccessOffice(office);
        allow create, update: if canManageOffice(office)
          && (request.resource.data.username == currentProfile().username
            || request.resource.data.user == currentProfile().username);
        allow delete: if canManageOffice(office)
          && (resource.data.username == currentProfile().username
            || resource.data.user == currentProfile().username);
      }
    }

    match /stationThermalInventory/{station} {
      allow get: if canReadStationThermal(station) || canAccessOffice('Thermal');
      allow list: if false;
      allow create, update: if canManageOffice('Thermal')
        && isThermalInventoryGroup(station)
        && request.resource.data.keys().hasOnly(['station', 'updatedAt', 'recordCount'])
        && request.resource.data.station == station
        && request.resource.data.updatedAt is string
        && request.resource.data.recordCount is int
        && request.resource.data.recordCount >= 0;
      allow delete: if canDeleteOffice('Thermal') && isThermalInventoryGroup(station);

      match /chunks/{chunkId} {
        allow get, list: if canReadStationThermal(station) || canAccessOffice('Thermal');
        allow create, update: if canManageOffice('Thermal')
          && isThermalInventoryGroup(station)
          && request.resource.data.keys().hasOnly(['records'])
          && request.resource.data.records is list;
        allow delete: if canDeleteOffice('Thermal') && isThermalInventoryGroup(station);
      }
    }

    match /stationThermalRecords/{station}/records/{recordId} {
      allow get, list: if (canReadStationThermal(station) && currentProfile().role == 'Station')
        || canAccessOffice('Thermal');
      allow create: if canReadStationThermal(station)
        && currentProfile().role == 'Station'
        && request.resource.data.keys().hasOnly([
          'stationRecordId', 'sourceRecordKey', 'rack', 'posNo', 'posUnit', 'serialNumber',
          'fullName', 'userId', 'address', 'status', 'lokals', 'noteIssue',
          'price', 'transferTo', 'columnJ', 'createdBy', 'recordDate'
        ])
        && request.resource.data.stationRecordId == recordId
        && (!('sourceRecordKey' in request.resource.data)
          || request.resource.data.sourceRecordKey is string)
        && request.resource.data.rack == station
        && request.resource.data.posNo is string
        && request.resource.data.posNo.size() > 0
        && request.resource.data.posNo.size() <= 120
        && request.resource.data.posUnit in ['', 'BOX', 'ROLLS', 'PCS']
        && request.resource.data.serialNumber is string
        && request.resource.data.fullName is string
        && request.resource.data.userId is string
        && request.resource.data.address is string
        && request.resource.data.status in ['Paid', 'Not Paid']
        && (('sourceRecordKey' in request.resource.data && request.resource.data.lokals is string)
          || request.resource.data.lokals == '')
        && request.resource.data.noteIssue is string
        && (request.resource.data.price is number || request.resource.data.price == '')
        && (('sourceRecordKey' in request.resource.data && request.resource.data.transferTo is string)
          || request.resource.data.transferTo == '')
        && (('sourceRecordKey' in request.resource.data && request.resource.data.columnJ is string)
          || request.resource.data.columnJ == '')
        && request.resource.data.createdBy == currentProfile().username
        && request.resource.data.recordDate is string;
      allow update: if canManageOffice('Thermal')
        || (canReadStationThermal(station)
          && currentProfile().role == 'Station'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['Paid', 'Not Paid']);
      allow delete: if canDeleteOffice('Thermal');
    }

    match /workspaceRequests/{requestId} {
      allow get, list: if canManageRequests()
        || (canSubmitRequests() && resource.data.createdByUid == request.auth.uid);
      allow create: if canSubmitRequests()
        && request.resource.data.keys().hasAll([
          'id', 'item', 'quantity', 'unit', 'station', 'requestee', 'notes',
          'requestedBy', 'requestedByUsername', 'createdByUid', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'item', 'quantity', 'unit', 'station', 'requestee', 'notes',
          'requestedBy', 'requestedByUsername', 'createdByUid', 'status', 'createdAt'
        ])
        && request.resource.data.id == requestId
        && request.resource.data.item == 'Thermal Paper'
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.unit in ['Boxes', 'Rolls']
        && request.resource.data.station is string
        && request.resource.data.station.size() > 0
        && request.resource.data.station.size() <= 120
        && request.resource.data.requestee is string
        && request.resource.data.requestee.size() <= 120
        && ((currentProfile().role == 'Station'
            && request.resource.data.requestee.size() == 0)
          || (currentProfile().role != 'Station'
            && request.resource.data.requestee.size() > 0))
        && request.resource.data.notes is string
        && request.resource.data.notes.size() > 0
        && request.resource.data.notes.size() <= 500
        && ((currentProfile().role == 'Collector'
            && request.resource.data.requestedBy == '')
          || (currentProfile().role != 'Collector'
            && request.resource.data.requestedBy == (currentProfile().name == ''
              ? currentProfile().username
              : currentProfile().name)))
        && request.resource.data.requestedByUsername == currentProfile().username
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'Pending'
        && request.resource.data.createdAt is string
        && (currentProfile().role != 'Station'
          || (isThermalStation(currentProfile().office)
            && request.resource.data.station == currentProfile().office))
        && (currentProfile().role != 'Collector'
          || request.resource.data.station == 'Collector');
      allow update: if canChangeRequestStatus()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectionNote'])
        && request.resource.data.status in ['Pending', 'Approved', 'Rejected']
        && request.resource.data.rejectionNote is string
        && request.resource.data.rejectionNote.size() <= 500;
      allow delete: if isAdmin();
    }
  }
}
